# Local development environment. `just dev-env` links backend/.env to
# ~/.config/zet-live/dev.env so every worktree shares these secrets.
#
# DATABASE_URL is deliberately absent: `just` derives one database per worktree
# from scripts/dev-db.sh. A value here would be ignored.

# Comma-separated logger=level list, e.g. zet_live=trace,query=trace,warn.
LOG_LEVEL="zet_live=info,warn"

# Both are required to start the admin API.
# ADMIN_KEY=""
ADMIN_BIND_TO="0.0.0.0:9013"

# Public base URL, used to build OAuth redirect URIs. Required before an auth
# provider can be enabled; the provider's own config lives in the database.
APP_URL="http://localhost:9011"

# Extra origins allowed as the OAuth popup postMessage target. APP_URL's origin
# is always allowed. Needed when the frontend runs on its own port.
ALLOWED_FRONTEND_ORIGINS="http://localhost:4173,http://localhost:5173"
