{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                  gs.shape_pt_lat  AS \"lat!: Option<f64>\"\n                , gs.shape_pt_lon  AS \"lon!: Option<f64>\"\n                , gs.shape_pt_sequence AS \"sequence!: Option<i32>\"\n            FROM gtfs_trips t\n            LEFT JOIN gtfs_shapes gs ON gs.shape_id = t.shape_id\n            WHERE t.trip_id = $1\n            ORDER BY gs.shape_pt_sequence\n            ",
