  "query": "\n            SELECT lst.stop_id, lst.stop_sequence, lst.arrival_time, s.stop_name\n            FROM live_trip_stop_times lst\n            LEFT JOIN gtfs_stops s ON s.stop_id = lst.stop_id\n            WHERE lst.trip_id = $1\n            ORDER BY lst.stop_sequence\n            ",
