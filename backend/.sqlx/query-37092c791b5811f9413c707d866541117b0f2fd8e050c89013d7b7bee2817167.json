  "query": "SELECT c.relname, i.indexdef\n         FROM pg_indexes i\n         JOIN pg_class c ON c.relname = i.indexname\n         JOIN pg_index x ON x.indexrelid = c.oid\n         WHERE i.schemaname = 'public'\n           AND i.tablename = $1\n           AND NOT x.indisprimary\n           AND NOT x.indisunique",
