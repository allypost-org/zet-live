  "query": "\n            SELECT\n                  lst.stop_sequence\n                , lst.arrival_time\n                , lst.arrival_delay\n                , lv.next_stop_sequence\n                , lv.next_stop_arrival_time\n            FROM live_trip_stop_times lst\n            LEFT JOIN live_vehicles lv ON lv.trip_id = lst.trip_id\n            WHERE lst.trip_id = $1\n            ORDER BY lst.stop_sequence\n            ",
