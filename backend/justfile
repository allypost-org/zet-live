set dotenv-load
set positional-arguments

rustflags := "-C target-feature=+crt-static"
rust_target := "x86_64-unknown-linux-musl"

# One postgres container serves every worktree, each with its own database.
# Never set DATABASE_URL in backend/.env: this is the only source of it.
export DATABASE_URL := `bash scripts/dev-db.sh url`

default:
    @just --list

build:
    SQLX_OFFLINE=true \
    RUSTFLAGS='{{ rustflags }}' \
    cargo build \
        --release \
        --target '{{ rust_target }}'

dev-watch *args:
    RUSTFLAGS='{{ rustflags }}' \
    watchexec \
        --clear=reset \
        --restart \
        --debounce '500ms' \
        --stop-signal 'kill' \
        -- \
          just dev-run "$@"

dev-run *args: migrations-run
    RUSTFLAGS='{{ rustflags }}' \
    cargo run \
        --target "{{ rust_target }}" \
        -- {{ args }} \

watch *args:
    RUSTFLAGS='{{ rustflags }}' \
    watchexec \
        --clear=reset \
        --restart \
        --debounce '500ms' \
        --stop-signal 'kill' \
        -- \
            just run "$@"

run *args:
    SQLX_OFFLINE=true \
    RUSTFLAGS='{{ rustflags }}' \
    cargo run \
        --target '{{ rust_target }}' \
        --release \
        -- "$@" \

test *args:
    SQLX_OFFLINE=true \
    RUSTFLAGS='{{ rustflags }}' \
    cargo test \
        --target '{{ rust_target }}' \
        --workspace \
        --all-features \
        -- "$@" \

test-watch *args:
    RUSTFLAGS='{{ rustflags }}' \
    watchexec \
        --clear=reset \
        --restart \
        --debounce '500ms' \
        --stop-signal 'kill' \
        -- \
            just test "$@"

fmt-dev: lint-fix && fmt
    rustup run nightly cargo fmt --all \

lint:
    SQLX_OFFLINE=true \
    cargo clippy \
        --workspace \
        --all-features \
        -- \

lint-fix:
    SQLX_OFFLINE=true \
    cargo clippy \
        --fix \
        --allow-dirty \
        --allow-staged \
        --workspace \
        --all-features \
        -- \

fmt:
    cargo fmt --all 2>/dev/null \

sqlx-regenerate:
    #!/usr/bin/env bash
    set -euo pipefail
    # Prepare only needs a migrated schema, so it runs against a scratch
    # database and leaves this worktree's data alone.
    bash scripts/dev-db.sh reset-scratch
    SQLX_OFFLINE="" \
    DATABASE_URL="$(just dev-env)" \
      cargo sqlx prepare --workspace

migrations-run:
    #!/usr/bin/env bash
    set -euo pipefail
    bash scripts/dev-db.sh migrate

migrations-list:
    sqlx migrate info

migrations-add $name="":
    name="{{ name }}"; \
    if [ -z "$name" ]; then \
        read -p "Enter migration name: " name; \
    fi; \
    sqlx migrate add -r "$name" \

# Manage this worktree's dev database: `just dev-db` lists the subcommands.
dev-db *args:
    @bash scripts/dev-db.sh {{ args }}

# Link backend/.env to a file shared by every worktree, so secrets are not copied per branch.
dev-env:
    @bash scripts/dev-db.sh env
